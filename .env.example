# =============================================================================
# AI Concierge Platform — environment configuration
# =============================================================================
# Copy this file to `.env` and fill in the values for your install.
# Anything left blank silently disables the feature it enables (except the
# REQUIRED block below — those are needed to boot at all).
#
# Levels:
#   REQUIRED              — app will not boot without this
#   STRONGLY RECOMMENDED  — app boots but a security/visibility footgun if missing
#   OPTIONAL              — feature turns off cleanly if missing
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED — app will not boot without these
# -----------------------------------------------------------------------------

# Postgres connection string. The app auto-creates all 80+ tables on first
# boot, so this can point at an empty database.
DATABASE_URL=postgresql://user:password@localhost:5432/aiconcierge

# Admin panel password. **Defaults to literally "admin" if unset** — that
# is a security footgun for any production install. Always override.
ADMIN_PASSWORD=change-me-please


# -----------------------------------------------------------------------------
# AI providers — at least ONE is required for the chatbot to function
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=


# -----------------------------------------------------------------------------
# STRONGLY RECOMMENDED — app boots but with reduced security/visibility
# -----------------------------------------------------------------------------

# Symmetric key for signing Flask session cookies. If unset, a random key
# is auto-generated and persisted to `.flask_secret` on the local disk —
# which means sessions don't survive a redeploy unless that file is on a
# persistent volume. Set this explicitly in any container/multi-replica
# deployment so all workers share the same key and sessions survive
# restarts.
FLASK_SECRET_KEY=

# Public canonical URL of this install (no trailing slash). Used in
# unsubscribe links, webhook callback URLs, SEO canonical tags, and the
# URL VELO Master calls back to. Falls back to REPLIT_DOMAINS on Replit
# hosts, then to the request's host header.
PUBLIC_BASE_URL=https://your-domain.com

# Set to "1" in production to force SESSION_COOKIE_SECURE (cookies only
# sent over HTTPS). On Replit deployments this is already implicit via
# REPLIT_DEPLOYMENT.
FORCE_SECURE_COOKIES=

# Where admin alert emails / SMS go. Without ADMIN_EMAIL the weekly
# digest can't be sent; without ADMIN_PHONE SMS alerts go nowhere.
ADMIN_EMAIL=
ADMIN_PHONE=


# -----------------------------------------------------------------------------
# Email (Resend) — required for outbound email (digests, password
# resets, contact form notifications)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@your-domain.com
RESEND_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# SMS (Twilio) — OPTIONAL, enables SMS notifications
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15551234567


# -----------------------------------------------------------------------------
# Storefront / checkout (Stripe) — OPTIONAL, enables the storefront and
# checkout flow. Without these the storefront is hidden.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# Voice agent (ElevenLabs) — OPTIONAL, enables AI voice playback
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=


# -----------------------------------------------------------------------------
# Web search tool (Brave Search) — OPTIONAL, gives the chatbot a search
# tool it can invoke during conversations
# -----------------------------------------------------------------------------
BRAVE_SEARCH_API_KEY=


# -----------------------------------------------------------------------------
# Review aggregator — OPTIONAL, pulls reviews from external sources for
# the chatbot to reference. Each is independent.
# -----------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=
TRIPADVISOR_API_KEY=


# -----------------------------------------------------------------------------
# Error tracking (Sentry) — OPTIONAL, enables exception reporting
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENV=production


# -----------------------------------------------------------------------------
# VELO Master integration — OPTIONAL, lets a separate VELO Master server
# orchestrate this install via the /api/velo/command surface (30 commands).
# Without these, the install runs standalone. See "VELO Master AI
# Integration" section in replit.md for the full picture.
# -----------------------------------------------------------------------------
VELO_MASTER_URL=
VELO_AGENT_KEY=

# SITE_URL is the URL VELO Master should call back to. If unset and you're
# on Replit, REPLIT_DOMAINS is used. Off-Replit, set this OR PUBLIC_BASE_URL.
SITE_URL=


# -----------------------------------------------------------------------------
# Replit-only (set automatically on Replit hosts; safe to ignore off-Replit)
# -----------------------------------------------------------------------------
# REPLIT_DOMAINS=your-repl.replit.dev
# REPLIT_DEPLOYMENT=1


# =============================================================================
# admin_ai_platform package config surface (M0–M19) — every config name
# =============================================================================
# Values shown are the DEFAULTS the app uses when the var is unset/blank.

# ---- Deployment & admin modes ----
DEPLOY_MODE=self_host          # central | self_host  (silo => self_host)
ADMIN_MODE=self_serve          # self_serve | agency_only
DEFAULT_TENANT_ID=1            # self_host pins everything to this tenant

# ---- Core infra ----
DB_POOL_MIN=2
DB_POOL_MAX=20
PORT=5000
PUBLIC_BASE_URL=               # external origin for building return URLs
UPLOADS_DIR=uploads
SESSION_SECRET=                # alias for FLASK_SECRET_KEY if that's unset
ADMIN_API_KEY=                 # Bearer key for programmatic admin (optional)
ADMIN_EMAIL=

# ---- Session cookie / cross-site WP embed ----
SESSION_COOKIE_SAMESITE=Lax    # Lax | Strict | None (None needs HTTPS + CSRF)
SESSION_COOKIE_SECURE=false
CSP_FRAME_ANCESTORS=           # WP origin allowed to iframe the admin (SSO)

# ---- LLM providers ----
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ---- ElevenLabs (premium voice) ----
ELEVENLABS_API_BASE=https://api.elevenlabs.io/v1

# ---- Voice limits ----
TTS_MAX_CHARS=800
VOICE_DAILY_CHAR_CAP=30000

# ---- Distribution / embedding ----
EMBED_ALLOWED_ORIGINS=         # comma-separated global allowlist (self_host)
EMBED_KEY_SIGNING_SECRET=      # falls back to FLASK_SECRET_KEY
SSO_SIGNING_SECRET=            # MUST be distinct; unset => SSO disabled (fail closed)
WIDGET_CDN_BASE=               # where /embed assets are served from (default same origin)

# ---- Scheduler / scaling (M10) ----
SCHEDULER_TICK_SECONDS=30
SCHEDULER_ADVISORY_LOCK_KEY=947213001
TRUSTED_PROXY_HOPS=0           # set 1 behind a single reverse proxy/LB
REDIS_URL=                     # optional shared rate limiter; else Postgres
RATE_LIMIT_MAX=40
RATE_LIMIT_WINDOW_SEC=60

# ---- External lookup providers (optional) ----
BRAVE_SEARCH_API_KEY=
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=
TRIPADVISOR_API_KEY=

# ---- Security (M19) ----
SECRETS_ENCRYPTION_KEY=        # urlsafe-base64 32B Fernet key; else derived from FLASK_SECRET_KEY
ENABLE_HSTS=false             # also auto-on when SESSION_COOKIE_SECURE=true

# ---- Migrations ----
SKIP_ALEMBIC=false            # the package self-bootstraps via additive init_db()

# ---- Agency control channel ----
VELO_SHARED_SECRET=           # master multi-install control (M22 fleet sync)
